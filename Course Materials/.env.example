# Non-secret runtime configuration only.
COURSE_HTTP_PORT=8080
APP_VERSION=0.1.0-dev
GIT_SHA=local
APP_ENVIRONMENT=course-lab
POSTGRES_DB=delivery
POSTGRES_USER=delivery

# Host-side source for the Compose secret. An instructor/admin installs this
# protected file; student scripts must not create, read, print or repair it.
POSTGRES_SECRET_SOURCE=./secrets/postgres_password.txt

# Local builds use delivery-api:local. CI/CD replaces this with an immutable
# ghcr.io/...@sha256:... reference.
DELIVERY_API_IMAGE=delivery-api:local
